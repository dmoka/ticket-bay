# Copy to .env and adjust. Everything here is optional for local development.

# Fake payment provider (src/payments). Any sk_test_ value works; the provider
# never touches the network and refuses sk_live_ keys outright.
STRIPE_SECRET_KEY=sk_test_51FAKEticketbayLocalDevKey000000000000000000

# SQLite file. Defaults to data/ticketbay.db.
# DATABASE_PATH=data/ticketbay.db
