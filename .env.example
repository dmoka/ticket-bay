# Local development settings. Copy to .env to change them; without a .env the
# npm scripts read this file directly. None of these are secrets — they only
# ever reach the throwaway Postgres in docker-compose.yml on your machine.

# Postgres from `npm run db:up` (docker-compose.yml reads the POSTGRES_* values).
POSTGRES_USER=ticketbay
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=ticketbay
DATABASE_URL=postgres://ticketbay:local-dev-only@localhost:5432/ticketbay

# Fake payment provider (src/payments). Any sk_test_ value works; the provider
# never touches the network and refuses sk_live_ keys outright.
STRIPE_SECRET_KEY=sk_test_51FAKEticketbayLocalDevKey000000000000000000
