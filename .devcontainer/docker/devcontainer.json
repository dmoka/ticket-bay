{
  // The box with its own Docker engine: `./box --docker`. The same box as ../devcontainer.json
  // (keep the two in sync), plus the Docker socket of a Colima VM that shares only this repo,
  // so Testcontainers, the integration tests and the UI tests run inside the box.
  "name": "TicketBay Sandbox + Docker (Colima)",
  "dockerComposeFile": ["../compose.yaml", "compose.yaml"],
  "service": "app",
  "runServices": ["app", "db"],
  // Refuses any engine but a Colima VM that shares only this repo (Docker Desktop shares your home).
  // Also creates the brain settings folder the box mounts read-only (compose.yaml).
  "initializeCommand": "mkdir -p \"${BOX_BRAIN_CONFIG:-$HOME/.config/brain}\" && ${localWorkspaceFolder}/.devcontainer/docker/check-engine.sh",
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "dbaeumer.vscode-eslint"]
    }
  },
  // Never root: Claude Code refuses --dangerously-skip-permissions as root.
  "remoteUser": "node",
  "mounts": [
    "source=ticketbay-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=ticketbay-claude-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=ticketbay-node-modules-${devcontainerId},target=/workspace/node_modules,type=volume",
    // The box's own copy of your second brain (module 5), cloned by brain-start.sh.
    "source=ticketbay-brain-${devcontainerId},target=/home/node/brain,type=volume"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1",
    // No claude.ai connectors (Gmail, Drive, ...) in the box: they would reach past the firewall.
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "workspaceFolder": "/workspace",
  "postCreateCommand": "sudo chown node:node /workspace/node_modules",
  // Then clones or pulls your brain and connects it to Claude Code in the box (brain-start.sh).
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && bash /workspace/.devcontainer/brain-start.sh",
  "waitFor": "postStartCommand"
}
