{
  // TicketBay sandbox. Based on Anthropic's reference dev container:
  // https://github.com/anthropics/claude-code/tree/main/.devcontainer (MIT)
  "name": "TicketBay Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:Europe/Budapest}",
      "CLAUDE_CODE_VERSION": "2.1.284",
      "GIT_DELTA_VERSION": "0.18.2"
    }
  },
  // The firewall runs inside the container, so it needs these two capabilities.
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "dbaeumer.vscode-eslint"]
    }
  },
  // Never root: Claude Code refuses --dangerously-skip-permissions as root.
  "remoteUser": "node",
  "mounts": [
    "source=ticketbay-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=ticketbay-claude-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=ticketbay-node-modules-${devcontainerId},target=/workspace/node_modules,type=volume"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "sudo chown node:node /workspace/node_modules",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
